  "uxCritiques": [
    {
      "screenId": "teacher-dashboard",
      "summary": "오늘 해야 할 업무를 첫 순서로 올리고 일정·공지·운영 상태를 뒤에 배치해 교사의 판단 흐름을 단순화했습니다. 모바일 플로팅 메모 버튼도 헤더의 명시적 동작으로 통합했습니다.",
      "status": "PASS"
    },
    {
      "screenId": "teacher-students",
      "summary": "필터·검색·새로고침을 한 도구 영역으로 묶고 명단을 중심에 유지했습니다. 긴 이메일과 좁은 화면에서도 학년·반이 비정상적으로 분절되지 않고 표 이동 안내가 유지됩니다.",
      "status": "PASS"
    },
    {
      "screenId": "teacher-quiz-bank",
      "summary": "문제 은행의 필터와 요약 지표, 목록 순서를 분명히 하고 URL 탭·뒤로가기 상태를 맞췄습니다. 문항과 응시 분석 오류를 분리해 부분 장애에서도 문제 수정 기능을 보존했습니다.",
      "status": "PASS"
    },
    {
      "screenId": "teacher-cutover",
      "summary": "학기 전환을 준비 학기·검증 상태·다음 단계 중심의 학교 운영 언어로 바꾸고 위험 작업은 비활성화했습니다. 내부 상태 코드와 식별자는 사용자 화면에서 제거했습니다.",
      "status": "PASS"
    },
    {
      "screenId": "student-today",
      "summary": "이어 할 학습을 가장 먼저, 일정과 공지를 다음에 배치하고 보조 상태는 뒤로 내렸습니다. 모바일 하단 메뉴와 경쟁하던 플로팅 동작을 제거하고 안전 여백을 확보했습니다.",
      "status": "PASS"
    }
