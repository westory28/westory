rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasAllowedSchoolEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@yongshin-ms\\.ms\\.kr$');
    }

    function applicationSessionPath() {
      return /databases/(default)/documents/application_sessions/$(request.auth.uid)/sessions/$(request.auth.token.auth_time);
    }

    function applicationSessionTransitionPath() {
      return /databases/(default)/documents/application_session_transitions/$(request.auth.uid);
    }

    function hasActiveApplicationSession() {
      let path = applicationSessionPath();
      let session = firestore.get(path).data;
      return isSignedIn()
        && request.auth.token.auth_time is int
        && firestore.exists(path)
        && session.status == 'active'
        && session.authTime == request.auth.token.auth_time
        && session.schemaVersion == 2
        && session.authorityGeneration == 'w1r2-2026-08-09'
        && session.protocolVersion is int
        && session.protocolVersion >= 2
        && session.sessionRevision is string
        && session.sessionRevision.matches('^[a-f0-9]{64}$')
        && session.authorityModeAtOpen in ['ENFORCE', 'OBSERVE_ONLY', 'DISABLED']
        && session.generalExpiresAt is timestamp
        && (
          session.authorityModeAtOpen != 'ENFORCE'
          || session.generalExpiresAt > request.time
        );
    }

    function hasActiveReauthTransition() {
      let path = applicationSessionTransitionPath();
      let transition = firestore.get(path).data;
      return isSignedIn()
        && request.auth.token.auth_time is int
        && firestore.exists(path)
        && transition.status == 'pending'
        && transition.schemaVersion == 1
        && transition.authorityGeneration == 'w1r2-2026-08-09'
        && transition.protocolVersion is int
        && transition.protocolVersion >= 2
        && transition.fromAuthTime is int
        && transition.fromAuthTime < request.auth.token.auth_time
        && transition.expiresAt is timestamp
        && transition.expiresAt > request.time;
    }

    function hasWestoryIdentity() {
      return isSignedIn()
        && request.auth.token.email is string
        && (hasAllowedSchoolEmail() || request.auth.token.email == "westoria28@gmail.com");
    }

    function hasValidMaintenanceBypassUids(uids) {
      let padded = uids.concat([
        'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x',
        'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x'
      ]);
      return uids.size() == 0 || (padded[0] is string && padded[0].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[1] is string && padded[1].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[2] is string && padded[2].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[3] is string && padded[3].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[4] is string && padded[4].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[5] is string && padded[5].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[6] is string && padded[6].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[7] is string && padded[7].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[8] is string && padded[8].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[9] is string && padded[9].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[10] is string && padded[10].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[11] is string && padded[11].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[12] is string && padded[12].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[13] is string && padded[13].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[14] is string && padded[14].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[15] is string && padded[15].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[16] is string && padded[16].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[17] is string && padded[17].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[18] is string && padded[18].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[19] is string && padded[19].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$'));
    }

    function isValidStudentMaintenanceConfig(config) {
      return config.keys().hasAll([
          'enabled', 'blockedRoles', 'bypassUids', 'title', 'message',
          'startedAt', 'updatedAt', 'updatedBy', 'revision'
        ])
        && config.keys().hasOnly([
          'enabled', 'blockedRoles', 'bypassUids', 'title', 'message',
          'startedAt', 'updatedAt', 'updatedBy', 'revision'
        ])
        && config.enabled is bool
        && config.blockedRoles == ['student']
        && config.bypassUids is list
        && config.bypassUids.size() <= 20
        && config.bypassUids.toSet().size() == config.bypassUids.size()
        && hasValidMaintenanceBypassUids(config.bypassUids)
        && config.title is string
        && config.title.matches('^\\S(?:[\\s\\S]{0,78}\\S)?$')
        && config.message is string
        && config.message.matches('^\\S(?:[\\s\\S]{0,498}\\S)?$')
        && ((config.enabled == true && config.startedAt is timestamp)
          || (config.enabled == false && config.startedAt == null))
        && config.updatedAt is timestamp
        && config.updatedBy is string
        && config.updatedBy.matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && config.revision is int
        && config.revision >= 0;
    }

    function canUseWestoryWithMaintenanceConfig(config) {
      return isValidStudentMaintenanceConfig(config)
        && (
          config.enabled == false
          || request.auth.token.email == "westoria28@gmail.com"
          || request.auth.uid in config.bypassUids
          || (
            firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role is string
            && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['student', 'teacher', 'staff']
            && !(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in config.blockedRoles)
          )
        );
    }

    function passesStudentMaintenanceFence() {
      return !firestore.exists(/databases/(default)/documents/site_settings/student_maintenance)
        || canUseWestoryWithMaintenanceConfig(
          firestore.get(/databases/(default)/documents/site_settings/student_maintenance).data
        );
    }

    function canUseWestory() {
      return hasWestoryIdentity()
        && (hasActiveApplicationSession() || hasActiveReauthTransition())
        && passesStudentMaintenanceFence()
        && passesStudentRegistrationFence();
    }

    function passesStudentRegistrationFence() {
      return request.auth.token.email == "westoria28@gmail.com"
        || (firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
          && approvedRegistrationProfile(firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data));
    }

    function approvedRegistrationProfile(profile) {
      return profile.role in ['student', 'teacher', 'staff']
        && profile.get('registrationApprovalStatus', 'APPROVED') == 'APPROVED';
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "westoria28@gmail.com" && canUseWestory();
    }

    function hasUserProfile() {
      return hasWestoryIdentity()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role is string;
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function hasStoragePermission(permission) {
      return canUseWestory()
        && hasUserProfile()
        && userProfile().teacherPortalEnabled == true
        && userProfile().staffPermissions is list
        && permission in userProfile().staffPermissions;
    }

    function isTeacherRole() {
      return canUseWestory() && hasUserProfile() && userProfile().role == "teacher";
    }

    function canReadSourceArchive() {
      return isAdmin() || isTeacherRole() || hasStoragePermission('lesson_read');
    }

    function canWriteSourceArchive() {
      return isAdmin() || isTeacherRole();
    }

    function canManageNoticeImages() {
      return isAdmin() || isTeacherRole();
    }

    function canManageDeveloperLogImages() {
      return isAdmin();
    }

    function hasRecentHighRiskSession() {
      let session = firestore.get(applicationSessionPath()).data;
      return hasActiveApplicationSession()
        && session.generalExpiresAt > request.time
        && session.highRiskExpiresAt is timestamp
        && session.highRiskExpiresAt > request.time
        && request.time.toMillis() - request.auth.token.auth_time * 1000 >= -60000
        && request.time.toMillis() - request.auth.token.auth_time * 1000 <= 300000;
    }

    function canManageWisImages() {
      return canUseWestory()
        && hasRecentHighRiskSession()
        && (request.auth.token.email == "westoria28@gmail.com"
          || (hasUserProfile()
            && (userProfile().role == 'teacher' || userProfile().get('teacherPortalEnabled', false) == true)
            && userProfile().staffPermissions is list
            && 'point_manage' in userProfile().staffPermissions));
    }

    function isWisImageUpload() {
      return request.resource != null
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.size > 0
        && request.resource.size <= 4 * 1024 * 1024;
    }

    function isCurrentWisScope(year, semester) {
      return year.matches('^\\d{4}$') && semester in ['1', '2']
        && firestore.get(/databases/(default)/documents/site_settings/semester_active).data.semesterId == year + '-' + semester;
    }

    function isNoticeImageUpload() {
      return request.resource != null
        && request.resource.contentType is string
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 700 * 1024;
    }

    function isDeveloperLogImageUpload() {
      return request.resource != null
        && request.resource.contentType is string
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 720 * 1024;
    }

    function isLessonPdfAssetUpload() {
      return request.resource != null
        && request.resource.contentType is string
        && (
          (
            request.resource.contentType == 'application/pdf'
            && request.resource.size < 20 * 1024 * 1024
          )
          || (
            request.resource.contentType.matches('image/.*')
            && request.resource.size < 6 * 1024 * 1024
          )
        );
    }

    function isSafeLessonPdfWrite() {
      return request.resource == null || isLessonPdfAssetUpload();
    }

    match /lesson_uploads/{uploadId}/source {
      // Server transport validates the session, teacher role and upload ticket.
      // Raw reads remain owner/admin only and fail closed during session fences.
      // Shared lesson display/re-extraction uses its verified saved asset URL.
      allow read: if canUseWestory() && resource != null
        && (resource.metadata.ownerUid == request.auth.uid
          || request.auth.token.email == "westoria28@gmail.com");
      allow write: if false;
    }
    match /map-resources/{resourceId}/{allPaths=**} {
      allow read: if canUseWestory();
      allow write: if false;
    }

    match /lesson_pdfs/{unitId}/{allPaths=**} {
      allow read: if canUseWestory();
      allow write: if false;
    }

    match /years/{year}/semesters/{semester}/lesson_pdfs/{unitId}/{allPaths=**} {
      allow read: if canUseWestory();
      allow write: if false;
    }

    match /years/{year}/semesters/{semester}/lesson_footnotes/{unitId}/{allPaths=**} {
      allow read: if canUseWestory();
      allow write: if false;
    }

    match /years/{year}/semesters/{semester}/notice_images/{noticeId}/{fileName} {
      allow read: if canUseWestory();
      allow create, update, delete: if false;
    }

    match /developer_log_images/{postId}/{fileName} {
      allow read: if canUseWestory();
      allow create, update: if canManageDeveloperLogImages() && isDeveloperLogImageUpload();
      allow delete: if canManageDeveloperLogImages();
    }

    match /years/{year}/semesters/{semester}/point_products/{productId}/{allPaths=**} {
      allow read: if canUseWestory();
    }

    match /years/{year}/semesters/{semester}/point_products/{productId}/{fileName} {
      allow create, update: if canManageWisImages()
        && isCurrentWisScope(year, semester)
        && fileName.matches('^(image|preview)\\.(jpg|webp)$')
        && isWisImageUpload();
    }

    match /site-settings/interface/hall-of-fame/{allPaths=**} {
      allow read: if canUseWestory();
    }

    match /site-settings/interface/hall-of-fame/{fileName} {
      allow create, update: if canManageWisImages()
        && fileName.matches('^podium-[0-9]+\\.jpg$')
        && isWisImageUpload();
    }

    match /site-settings/interface/{folder}/{allPaths=**} {
      allow read: if canUseWestory();
      allow write: if folder != 'hall-of-fame' && isAdmin();
    }

    match /source-archive/{assetId}/incoming/{fileName} {
      allow read: if false;
      allow write: if false;
    }

    // Processed assets live under a revision folder. Keep incoming uploads private.
    match /source-archive/{assetId}/{revision}/{fileName} {
      allow read: if canReadSourceArchive() && revision != 'incoming';
      allow write: if false;
    }
  }
}
