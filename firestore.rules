rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function hasAllowedSchoolEmail() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.matches('.*@yongshin-ms\\.ms\\.kr$');
    }

    function applicationSessionPath() {
      return /databases/$(database)/documents/application_sessions/$(request.auth.uid)/sessions/$(request.auth.token.auth_time);
    }

    function applicationSessionTransitionPath() {
      return /databases/$(database)/documents/application_session_transitions/$(request.auth.uid);
    }

    function hasActiveApplicationSession() {
      let session = get(applicationSessionPath()).data;
      return isSignedIn()
        && request.auth.token.auth_time is int
        && session.status == 'active'
        && session.authTime == request.auth.token.auth_time
        && session.schemaVersion == 2
        && session.authorityGeneration == 'w1r2-2026-08-09'
        && session.protocolVersion is int
        && session.protocolVersion >= 2
        && session.sessionRevision is string
        && session.sessionRevision.matches('^[a-f0-9]{64}$')
        && session.authorityModeAtOpen in ['ENFORCE', 'OBSERVE_ONLY', 'DISABLED']
        && session.generalExpiresAt is timestamp
        && (
          session.authorityModeAtOpen != 'ENFORCE'
          || session.generalExpiresAt > request.time
        );
    }

    function hasActiveHighRiskSession() {
      let session = get(applicationSessionPath()).data;
      return hasActiveApplicationSession()
        && session.highRiskExpiresAt is timestamp
        && (
          session.authorityModeAtOpen != 'ENFORCE'
          || session.highRiskExpiresAt > request.time
        );
    }

    function hasActiveReauthTransition() {
      let transition = get(applicationSessionTransitionPath()).data;
      return isSignedIn()
        && request.auth.token.auth_time is int
        && transition.status == 'pending'
        && transition.schemaVersion == 1
        && transition.authorityGeneration == 'w1r2-2026-08-09'
        && transition.protocolVersion is int
        && transition.protocolVersion >= 2
        && transition.fromAuthTime is int
        && transition.fromAuthTime < request.auth.token.auth_time
        && transition.expiresAt is timestamp
        && transition.expiresAt > request.time;
    }

    function hasRecentAuthentication() {
      return isSignedIn()
        && request.auth.token.auth_time is int
        && request.time.toMillis() - request.auth.token.auth_time * 1000 >= -60000
        && request.time.toMillis() - request.auth.token.auth_time * 1000 <= 300000;
    }

    function hasWestoryIdentity() {
      return isSignedIn()
        && request.auth.token.email is string
        && (hasAllowedSchoolEmail() || request.auth.token.email == "westoria28@gmail.com");
    }

    function hasValidMaintenanceBypassUids(uids) {
      let padded = uids.concat([
        'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x',
        'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x', 'x'
      ]);
      return padded[0] is string && padded[0].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[1] is string && padded[1].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[2] is string && padded[2].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[3] is string && padded[3].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[4] is string && padded[4].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[5] is string && padded[5].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[6] is string && padded[6].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[7] is string && padded[7].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[8] is string && padded[8].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[9] is string && padded[9].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[10] is string && padded[10].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[11] is string && padded[11].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[12] is string && padded[12].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[13] is string && padded[13].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[14] is string && padded[14].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[15] is string && padded[15].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[16] is string && padded[16].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[17] is string && padded[17].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[18] is string && padded[18].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && padded[19] is string && padded[19].matches('^\\S(?:[\\s\\S]{0,126}\\S)?$');
    }

    function isValidStudentMaintenanceConfig(config) {
      return config.keys().hasAll([
          'enabled', 'blockedRoles', 'bypassUids', 'title', 'message',
          'startedAt', 'updatedAt', 'updatedBy', 'revision'
        ])
        && config.keys().hasOnly([
          'enabled', 'blockedRoles', 'bypassUids', 'title', 'message',
          'startedAt', 'updatedAt', 'updatedBy', 'revision'
        ])
        && config.enabled is bool
        && config.blockedRoles == ['student']
        && config.bypassUids is list
        && config.bypassUids.size() <= 20
        && config.bypassUids.toSet().size() == config.bypassUids.size()
        && hasValidMaintenanceBypassUids(config.bypassUids)
        && config.title is string
        && config.title.matches('^\\S(?:[\\s\\S]{0,78}\\S)?$')
        && config.message is string
        && config.message.matches('^\\S(?:[\\s\\S]{0,498}\\S)?$')
        && ((config.enabled == true && config.startedAt is timestamp)
          || (config.enabled == false && config.startedAt == null))
        && config.updatedAt is timestamp
        && config.updatedBy is string
        && config.updatedBy.matches('^\\S(?:[\\s\\S]{0,126}\\S)?$')
        && config.revision is int
        && config.revision >= 0;
    }

    function canUseWestoryWithMaintenanceConfig(config) {
      return isValidStudentMaintenanceConfig(config)
        && (
          config.enabled == false
          || request.auth.token.email == "westoria28@gmail.com"
          || request.auth.uid in config.bypassUids
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role is string
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['student', 'teacher', 'staff']
            && !(get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in config.blockedRoles)
          )
        );
    }

    function passesStudentMaintenanceFence() {
      return !exists(/databases/$(database)/documents/site_settings/student_maintenance)
        || canUseWestoryWithMaintenanceConfig(
          get(/databases/$(database)/documents/site_settings/student_maintenance).data
        );
    }

    function canBootstrapWestory() {
      return hasWestoryIdentity()
        && (hasActiveApplicationSession() || hasActiveReauthTransition())
        && passesStudentMaintenanceFence();
    }

    function passesStudentRegistrationFence() {
      return request.auth.token.email == "westoria28@gmail.com"
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && approvedRegistrationProfile(get(/databases/$(database)/documents/users/$(request.auth.uid)).data));
    }

    function approvedRegistrationProfile(profile) {
      return profile.role in ['student', 'teacher', 'staff']
        && profile.get('registrationApprovalStatus', 'APPROVED') == 'APPROVED';
    }

    function canUseWestory() {
      return canBootstrapWestory() && passesStudentRegistrationFence();
    }

    // Current academic material is identified by three agreeing server records.
    // Missing configuration never falls back to a default year or semester.
    function isCurrentSemesterScope(year, semester) {
      let config = get(/databases/$(database)/documents/site_settings/config).data;
      let pointer = get(/databases/$(database)/documents/site_settings/semester_active).data;
      let semesterId = year + '-' + semester;
      let manifest = get(/databases/$(database)/documents/semester_manifests/$(semesterId)).data;
      return year is string && year.matches('^[0-9]{4}$')
        && semester is string && semester in ['1', '2']
        && config.year == year && config.semester == semester
        && pointer.semesterId == semesterId
        && pointer.revision is int
        && manifest.semesterId == semesterId
        && manifest.status == 'ACTIVE'
        && manifest.revision == pointer.revision;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "westoria28@gmail.com" && canUseWestory();
    }

    function isRecentlyAuthenticatedAdmin() {
      return isAdmin() && hasActiveHighRiskSession() && hasRecentAuthentication();
    }

    function isOwnUser(userId) {
      return canUseWestory() && request.auth.uid == userId;
    }

    function hasUserProfile() {
      return hasWestoryIdentity()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isTrustedW10PVisualFixtureAdmin() {
      // Synthetic capture authority exists only in firestore.staging.rules.
      return false;
    }

    function hasPermission(permission) {
      return canUseWestory()
        && hasUserProfile()
        && userProfile().teacherPortalEnabled == true
        && userProfile().staffPermissions is list
        && permission in userProfile().staffPermissions;
    }

    function userGrade() {
      return userProfile().grade;
    }

    function userClass() {
      return userProfile().class;
    }

    function canAccessThinkCloudTarget(targetGrade, targetClass) {
      return isAdmin()
        || (canUseWestory()
          && hasUserProfile()
          && targetGrade == userGrade()
          && targetClass == userClass());
    }

    function isAnonymousThinkCloudSession(session) {
      return session.keys().hasAny(['options'])
        && session.options is map
        && session.options.keys().hasAny(['anonymous'])
        && session.options.anonymous == true;
    }

    function canReadThinkCloudResponse(session) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return canUseWestory()
        && (
          request.auth.token.email == "westoria28@gmail.com"
          || (
            session.targetGrade == profile.grade
            && session.targetClass == profile.class
            && (
              profile.role == 'teacher'
              || (
                profile.teacherPortalEnabled == true
                && profile.staffPermissions is list
                && 'lesson_read' in profile.staffPermissions
              )
              || !isAnonymousThinkCloudSession(session)
            )
          )
        );
    }

    function canReadPointData() {
      return isAdmin() || hasPermission('point_read') || hasPermission('point_manage');
    }

    function canManagePointData() {
      return isAdmin() || hasPermission('point_manage');
    }

    function isTeacherRole() {
      return canUseWestory() && hasUserProfile() && userProfile().role == 'teacher';
    }

    function isStudentRole() {
      return canUseWestory() && hasUserProfile() && userProfile().role == 'student';
    }

    function canManageStudentEnrollmentData() {
      return isAdmin() || hasPermission('student_list_read');
    }

    function isArchivedSemester(semesterId) {
      let manifest = get(/databases/$(database)/documents/semester_manifests/$(semesterId)).data;
      return manifest.status in ['CLOSED', 'ARCHIVED'];
    }

    function canReadSemesterEnrollmentResource(data) {
      return isAdmin()
        || (
          canUseWestory()
          && !isArchivedSemester(data.semesterId)
          && (
            canManageStudentEnrollmentData()
            || data.studentUid == request.auth.uid
          )
        );
    }

    function developerLogLikePath(logId) {
      return /databases/$(database)/documents/developer_logs/$(logId)/likes/$(request.auth.uid);
    }

    function settingsDeveloperLogLikePath(logId) {
      return /databases/$(database)/documents/site_settings/developer_logs/items/$(logId)/likes/$(request.auth.uid);
    }

    function isDeveloperLogViewUpdate() {
      return canUseWestory()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
        && request.resource.data.viewCount == resource.data.viewCount + 1;
    }

    function isDeveloperLogLikeCountUpdate(logId) {
      return canUseWestory()
        && isStudentRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && (
          (
            request.resource.data.likeCount == resource.data.likeCount + 1
            && !exists(developerLogLikePath(logId))
            && existsAfter(developerLogLikePath(logId))
          )
          || (
            request.resource.data.likeCount == resource.data.likeCount - 1
            && exists(developerLogLikePath(logId))
            && !existsAfter(developerLogLikePath(logId))
          )
        );
    }

    function isSettingsDeveloperLogLikeCountUpdate(logId) {
      return canUseWestory()
        && isStudentRole()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
        && (
          (
            request.resource.data.likeCount == resource.data.likeCount + 1
            && !exists(settingsDeveloperLogLikePath(logId))
            && existsAfter(settingsDeveloperLogLikePath(logId))
          )
          || (
            request.resource.data.likeCount == resource.data.likeCount - 1
            && exists(settingsDeveloperLogLikePath(logId))
            && !existsAfter(settingsDeveloperLogLikePath(logId))
          )
        );
    }

    // The caller has already passed canUseWestory. Avoid re-evaluating the
    // full session and maintenance fence for every alternative role branch.
    function currentProfileHasAcademicPermission(permission) {
      let profile = userProfile();
      return permission != '' && profile.get('teacherPortalEnabled', false) == true
        && profile.get('staffPermissions', []) is list
        && permission in profile.get('staffPermissions', []);
    }

    function canReadOwnedAcademicResource(ownerUid, permission) {
      return canUseWestory() && (
        ownerUid == request.auth.uid
        || request.auth.token.email == "westoria28@gmail.com"
        || currentUserIsTeacherProfile()
        || currentProfileHasAcademicPermission(permission)
      );
    }

    function canReadQuizResult(data) {
      return canReadOwnedAcademicResource(data.uid, 'quiz_read');
    }

    function canReadQuizSubmission(data) {
      return canReadOwnedAcademicResource(data.uid, 'quiz_read');
    }

    function isAssignedHistoryClassroomStudent(data) {
      return canUseWestory()
        && (
          (
            data.keys().hasAny(['targetStudentUid'])
            && data.targetStudentUid == request.auth.uid
          )
          || (
            data.keys().hasAny(['targetStudentAccessMap'])
            && data.targetStudentAccessMap is map
            && data.targetStudentAccessMap[request.auth.uid] == true
          )
          || (
            data.keys().hasAny(['targetStudentUids'])
            && data.targetStudentUids is list
            && request.auth.uid in data.targetStudentUids
          )
        );
    }

    function canReadHistoryClassroomResource(data) {
      return canUseWestory() && (
        request.auth.token.email == "westoria28@gmail.com"
        || currentUserIsTeacherProfile()
        || data.get('targetStudentUid', '') == request.auth.uid
        || (data.get('targetStudentAccessMap', {}) is map
          && data.get('targetStudentAccessMap', {}).get(request.auth.uid, false) == true)
        || (data.get('targetStudentUids', []) is list
          && request.auth.uid in data.get('targetStudentUids', []))
      );
    }

    function canWriteHistoryClassroomResource() {
      return isAdmin() || isTeacherRole();
    }

    function canReadHistoryClassroomResult(data) {
      return canReadOwnedAcademicResource(data.uid, '');
    }

    function canReadHistoryClassroomExemption(data) {
      return canReadOwnedAcademicResource(data.uid, '');
    }

    function canReadSourceArchive() {
      return isAdmin() || isTeacherRole() || hasPermission('lesson_read');
    }

    function canWriteSourceArchive() {
      return isAdmin() || isTeacherRole();
    }

    function canReadHistoryDictionaryRequest(data) {
      return canReadOwnedAcademicResource(data.uid, 'lesson_read');
    }

    function canReadOwnPointResource(targetUid) {
      return canUseWestory() && targetUid == request.auth.uid;
    }

    function canManagePerformanceScores() {
      return canUseWestory() && (request.auth.token.email == "westoria28@gmail.com" || currentUserIsTeacherProfile());
    }

    function currentUserIsTeacherProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    function currentUserCanReadStudentListProfile() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return profile.role == 'teacher'
        || (
          profile.teacherPortalEnabled == true
          && profile.staffPermissions is list
          && 'student_list_read' in profile.staffPermissions
        );
    }

    function canListUserDocuments() {
      return canUseWestory()
        && (
          request.auth.token.email == "westoria28@gmail.com"
          || currentUserCanReadStudentListProfile()
        );
    }

    function canGetUserDocument(userId) {
      return (hasWestoryIdentity() && request.auth.uid == userId)
        || (
          canUseWestory()
          && (
            request.auth.token.email == "westoria28@gmail.com"
            || currentUserCanReadStudentListProfile()
          )
        );
    }

    function isTeacherPatchNoteOwner(teacherId) {
      return canUseWestory()
        && request.auth.uid == teacherId
        && (
          request.auth.token.email == "westoria28@gmail.com"
          || currentUserIsTeacherProfile()
        );
    }

    function isTeacherPatchNoteListQuery() {
      let orderBy = request.query.orderBy;
      return request.query.limit is int
        && request.query.limit > 0
        && request.query.limit <= 100
        && orderBy is map
        && orderBy.keys().hasOnly(['updatedAt', '__name__'])
        && orderBy.updatedAt == 'DESC'
        && orderBy['__name__'] == 'DESC';
    }

    function isValidTeacherPatchNoteRect(rect) {
      let rectKeys = rect is map ? rect.keys() : [];
      return rect == null
        || (
          rect is map
          && rectKeys.hasOnly(['x', 'y', 'width', 'height'])
          && rect.x is number
          && rect.y is number
          && rect.width is number
          && rect.height is number
          && rect.x >= -20000
          && rect.x <= 20000
          && rect.y >= -20000
          && rect.y <= 20000
          && rect.width >= 0
          && rect.width <= 20000
          && rect.height >= 0
          && rect.height <= 20000
        );
    }

    function hasOnlyTeacherPatchNoteKeys() {
      return request.resource.data.keys().hasOnly([
        'ownerUid',
        'title',
        'body',
        'type',
        'priority',
        'status',
        'sourcePath',
        'targetLabel',
        'targetText',
        'targetSelector',
        'targetRect',
        'createdAt',
        'updatedAt',
        'completedAt'
      ]);
    }

    function hasValidTeacherPatchNoteFields(teacherId) {
      let data = request.resource.data;
      return hasOnlyTeacherPatchNoteKeys()
        && data.ownerUid == teacherId
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 80
        && data.body is string
        && data.body.size() <= 2000
        && data.type in ['bug', 'improvement', 'content', 'etc']
        && data.priority in ['normal', 'high']
        && data.status in ['open', 'done']
        && data.sourcePath is string
        && data.sourcePath.size() > 0
        && data.sourcePath.size() <= 240
        && data.sourcePath.matches('^/teacher.*')
        && data.targetLabel is string
        && data.targetLabel.size() <= 120
        && data.targetText is string
        && data.targetText.size() <= 240
        && data.targetSelector is string
        && data.targetSelector.size() <= 240
        && isValidTeacherPatchNoteRect(data.targetRect)
        && (
          (data.status == 'open' && data.completedAt == null)
          || (data.status == 'done' && data.completedAt is timestamp)
        );
    }

    function isValidTeacherPatchNoteCreate(teacherId) {
      return isTeacherPatchNoteOwner(teacherId)
        && hasValidTeacherPatchNoteFields(teacherId)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function isValidTeacherPatchNoteUpdate(teacherId) {
      return isTeacherPatchNoteOwner(teacherId)
        && hasValidTeacherPatchNoteFields(teacherId)
        && resource.data.ownerUid == teacherId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
    }

    function canReadPerformanceScoreObjection(data) {
      return canReadOwnedAcademicResource(data.uid, '');
    }

    function canReadPerformanceScoreAnswerSheetRequest(data) {
      return canReadOwnedAcademicResource(data.uid, '');
    }

    function performanceScorePath(userId, scoreId) {
      return /databases/$(database)/documents/users/$(userId)/performance_scores/$(scoreId);
    }

    function performanceScoreConsentPath(userId) {
      return /databases/$(database)/documents/users/$(userId)/performance_score_consents/current;
    }

    function performanceScoreSettingsPath(year, semester) {
      return /databases/$(database)/documents/years/$(year)/semesters/$(semester)/assessment_config/performance_score;
    }

    function isValidPerformanceScoreConsent(userId, consentId) {
      return canUseWestory()
        && isOwnUser(userId)
        && consentId == 'current'
        && request.resource.data.keys().hasOnly([
          'uid',
          'academicYear',
          'semester',
          'acknowledged',
          'warningVersion',
          'warningTextHash',
          'acknowledgedAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.academicYear is string
        && request.resource.data.academicYear.size() > 0
        && request.resource.data.academicYear.size() <= 8
        && request.resource.data.semester is string
        && request.resource.data.semester.size() > 0
        && request.resource.data.semester.size() <= 8
        && request.resource.data.acknowledged == true
        && request.resource.data.warningVersion is string
        && request.resource.data.warningVersion.size() > 0
        && request.resource.data.warningVersion.size() <= 80
        && request.resource.data.warningTextHash is string
        && request.resource.data.warningTextHash.size() > 0
        && request.resource.data.warningTextHash.size() <= 32
        && request.resource.data.acknowledgedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function hasCurrentPerformanceScoreConsent(userId, scoreId) {
      return exists(performanceScoreConsentPath(userId))
        && hasMatchingPerformanceScoreConsent(userId, scoreId);
    }

    function hasMatchingPerformanceScoreConsent(userId, scoreId) {
      let scoreData = get(performanceScorePath(userId, scoreId)).data;
      let consentData = get(performanceScoreConsentPath(userId)).data;
      let settingsPath = performanceScoreSettingsPath(scoreData.academicYear, scoreData.semester);
      return consentData.uid == request.auth.uid
        && consentData.acknowledged == true
        && consentData.academicYear == scoreData.academicYear
        && consentData.semester == scoreData.semester
        && consentData.warningVersion is string
        && consentData.warningTextHash is string
        && (
          (
            exists(settingsPath)
            && consentData.warningVersion == get(settingsPath).data.warningVersion
            && (
              !get(settingsPath).data.keys().hasAny(['warningTextHash'])
              || consentData.warningTextHash == get(settingsPath).data.warningTextHash
            )
          )
          || (
            !exists(settingsPath)
            && consentData.warningVersion == 'default-20260609'
          )
        );
    }

    function isValidPerformanceScoreConfirmation(userId, scoreId, confirmationId) {
      return canUseWestory()
        && isOwnUser(userId)
        && confirmationId == request.auth.uid
        && exists(performanceScorePath(userId, scoreId))
        && get(performanceScorePath(userId, scoreId)).data.uid == request.auth.uid
        && get(performanceScorePath(userId, scoreId)).data.rosterId == scoreId
        && hasCurrentPerformanceScoreConsent(userId, scoreId)
        && request.resource.data.keys().hasOnly([
          'uid',
          'rosterId',
          'signatureName',
          'signatureImage',
          'confirmedAt',
          'updatedAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rosterId == scoreId
        && request.resource.data.signatureName is string
        && request.resource.data.signatureName.size() > 0
        && request.resource.data.signatureName.size() <= 20
        && request.resource.data.signatureImage is string
        && request.resource.data.signatureImage.size() > 0
        && request.resource.data.signatureImage.size() <= 120000
        && request.resource.data.signatureImage.matches('^data:image/png;base64,[A-Za-z0-9+/=]+$')
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.updatedAt == request.time;
    }

    function canCreatePerformanceScoreConfirmation(userId, scoreId, confirmationId) {
      return !exists(/databases/$(database)/documents/users/$(userId)/performance_scores/$(scoreId)/confirmations/$(confirmationId))
        && isValidPerformanceScoreConfirmation(userId, scoreId, confirmationId);
    }

    function hasCompletePerformanceScoreSignature(data) {
      return data.signatureImage is string
        && data.signatureImage.size() > 0
        && data.signatureName is string
        && data.signatureName.size() > 0;
    }

    function canRepairPerformanceScoreConfirmation(userId, scoreId, confirmationId) {
      return isValidPerformanceScoreConfirmation(userId, scoreId, confirmationId)
        && resource.data.uid == request.auth.uid
        && resource.data.rosterId == scoreId
        && !hasCompletePerformanceScoreSignature(resource.data);
    }

    function changedUserKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function hasOnlyUserDocKeys() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'email',
        'photoURL',
        'role',
        'registrationApprovalStatus',
        'staffPermissions',
        'teacherPortalEnabled',
        'name',
        'customNameConfirmed',
        'grade',
        'class',
        'number',
        'privacyAgreed',
        'privacyAgreedAt',
        'consentAgreedItems',
        'profileIcon',
        'profileEmojiId',
        'myPageGoalScore',
        'myPageSubjectGoals',
        'scoreWarningAcknowledged',
        'scoreWarningAcknowledgedAt',
        'createdAt',
        'updatedAt',
        'lastLogin'
      ]);
    }

    function hasValidOwnUserFieldTypes() {
      return (!request.resource.data.keys().hasAny(['uid']) || (request.resource.data.uid is string && request.resource.data.uid == request.auth.uid))
        && (!request.resource.data.keys().hasAny(['email']) || (request.resource.data.email is string && request.resource.data.email == request.auth.token.email))
        && (!request.resource.data.keys().hasAny(['photoURL']) || request.resource.data.photoURL is string)
        && (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['student', 'staff', 'teacher'])
        && (!request.resource.data.keys().hasAny(['teacherPortalEnabled']) || request.resource.data.teacherPortalEnabled is bool)
        && (!request.resource.data.keys().hasAny(['staffPermissions']) || request.resource.data.staffPermissions is list)
        && (!request.resource.data.keys().hasAny(['name']) || (request.resource.data.name is string && request.resource.data.name.size() <= 20))
        && (!request.resource.data.keys().hasAny(['customNameConfirmed']) || request.resource.data.customNameConfirmed is bool)
        && (!request.resource.data.keys().hasAny(['grade']) || (request.resource.data.grade is string && request.resource.data.grade.size() <= 8))
        && (!request.resource.data.keys().hasAny(['class']) || (request.resource.data.class is string && request.resource.data.class.size() <= 8))
        && (!request.resource.data.keys().hasAny(['number']) || (request.resource.data.number is string && request.resource.data.number.size() <= 8))
        && (!request.resource.data.keys().hasAny(['privacyAgreed']) || request.resource.data.privacyAgreed is bool)
        && (!request.resource.data.keys().hasAny(['consentAgreedItems']) || (
          request.resource.data.consentAgreedItems is list
          && request.resource.data.consentAgreedItems.size() <= 50
        ))
        && (!request.resource.data.keys().hasAny(['profileIcon']) || (request.resource.data.profileIcon is string && request.resource.data.profileIcon.size() <= 16))
        && (!request.resource.data.keys().hasAny(['profileEmojiId']) || (request.resource.data.profileEmojiId is string && request.resource.data.profileEmojiId.size() <= 64))
        && (!request.resource.data.keys().hasAny(['myPageGoalScore']) || (request.resource.data.myPageGoalScore is string && request.resource.data.myPageGoalScore.size() <= 120))
        && (!request.resource.data.keys().hasAny(['myPageSubjectGoals']) || (
          request.resource.data.myPageSubjectGoals is map
          && request.resource.data.myPageSubjectGoals.keys().size() <= 30
        ))
        && (!request.resource.data.keys().hasAny(['scoreWarningAcknowledged']) || request.resource.data.scoreWarningAcknowledged is bool);
    }

    function isValidOwnStudentCreate(userId) {
      return isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('registrationApprovalStatus', '') == 'PENDING'
        && hasOnlyUserDocKeys()
        && hasValidOwnUserFieldTypes()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'student'
        && (!request.resource.data.keys().hasAny(['teacherPortalEnabled']) || request.resource.data.teacherPortalEnabled == false)
        && (!request.resource.data.keys().hasAny(['staffPermissions']) || request.resource.data.staffPermissions.size() == 0)
        && canBootstrapWestory();
    }

    function protectedUserFieldsUnchanged() {
      let requestTeacherPortalEnabled = request.resource.data.keys().hasAny(['teacherPortalEnabled'])
        ? request.resource.data.teacherPortalEnabled
        : false;
      let resourceTeacherPortalEnabled = resource.data.keys().hasAny(['teacherPortalEnabled'])
        ? resource.data.teacherPortalEnabled
        : false;
      let requestStaffPermissions = request.resource.data.keys().hasAny(['staffPermissions']) && request.resource.data.staffPermissions is list
        ? request.resource.data.staffPermissions
        : [];
      let resourceStaffPermissions = resource.data.keys().hasAny(['staffPermissions']) && resource.data.staffPermissions is list
        ? resource.data.staffPermissions
        : [];

      return request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && requestTeacherPortalEnabled == resourceTeacherPortalEnabled
        && requestStaffPermissions == resourceStaffPermissions;
    }

    function isValidOwnStudentUpdate(userId) {
      return isSignedIn() && request.auth.uid == userId
        && protectedUserFieldsUnchanged()
        && (
          changedUserKeys().hasOnly([
            'photoURL',
            'lastLogin',
            'updatedAt',
            'myPageGoalScore',
            'myPageSubjectGoals',
            'scoreWarningAcknowledged',
            'scoreWarningAcknowledgedAt',
            'privacyAgreed',
            'privacyAgreedAt',
            'consentAgreedItems'
          ])
          || (
            resource.data.role == 'student'
            && resource.data.customNameConfirmed != true
            && request.resource.data.customNameConfirmed == true
            && changedUserKeys().hasOnly([
              'photoURL',
              'lastLogin',
              'updatedAt',
              'privacyAgreed',
              'privacyAgreedAt',
              'consentAgreedItems',
              'name',
              'grade',
              'class',
              'number',
              'customNameConfirmed'
            ])
          )
        )
        && hasValidOwnUserFieldTypes()
        && canBootstrapWestory();
    }

    function isValidQuizResultCreate() {
      return canUseWestory()
        && request.resource.data.keys().hasOnly([
          'uid',
          'name',
          'email',
          'class',
          'number',
          'gradeClass',
          'unitId',
          'category',
          'examRound',
          'score',
          'details',
          'status',
          'timestamp',
          'timeString'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.class is string
        && request.resource.data.number is string
        && request.resource.data.gradeClass is string
        && request.resource.data.unitId is string
        && request.resource.data.category is string
        && (!request.resource.data.keys().hasAny(['examRound']) || request.resource.data.examRound is string)
        && request.resource.data.score is number
        && request.resource.data.details is list
        && request.resource.data.details.size() <= 200
        && request.resource.data.status is string
        && request.resource.data.timeString is string;
    }

    function hasOnlyQuizSubmissionKeys() {
      return request.resource.data.keys().hasOnly([
        'uid',
        'name',
        'email',
        'class',
        'number',
        'gradeClass',
        'unitId',
        'category',
        'examRound',
        'title',
        'status',
        'questionIds',
        'answers',
        'currentIndex',
        'hintUsedCount',
        'revealedHintIds',
        'orderOptionMap',
        'timeLimitSeconds',
        'clientStartedAtMs',
        'lastClientSavedAtMs',
        'startedAt',
        'lastSavedAt',
        'submittedAt',
        'resultId'
      ]);
    }

    function isValidQuizSubmissionPayload() {
      return hasOnlyQuizSubmissionKeys()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.class is string
        && request.resource.data.number is string
        && request.resource.data.gradeClass is string
        && request.resource.data.unitId is string
        && request.resource.data.category is string
        && (!request.resource.data.keys().hasAny(['examRound']) || request.resource.data.examRound is string)
        && request.resource.data.title is string
        && request.resource.data.status in ['in_progress', 'submitted', 'timed_out']
        && request.resource.data.questionIds is list
        && request.resource.data.questionIds.size() <= 100
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().size() <= 200
        && request.resource.data.currentIndex is number
        && request.resource.data.hintUsedCount is number
        && request.resource.data.revealedHintIds is list
        && request.resource.data.revealedHintIds.size() <= 100
        && request.resource.data.orderOptionMap is map
        && request.resource.data.timeLimitSeconds is number
        && request.resource.data.clientStartedAtMs is number
        && request.resource.data.lastClientSavedAtMs is number
        && request.resource.data.startedAt is timestamp
        && request.resource.data.lastSavedAt is timestamp
        && (!request.resource.data.keys().hasAny(['submittedAt']) || request.resource.data.submittedAt is timestamp)
        && request.resource.data.resultId is string;
    }

    function isValidQuizSubmissionCreate() {
      return canUseWestory()
        && isValidQuizSubmissionPayload();
    }

    function isValidQuizSubmissionUpdate() {
      return canUseWestory()
        && (
          !resource.data.keys().hasAny(['uid'])
          || resource.data.uid == request.auth.uid
        )
        && (
          !resource.data.keys().hasAny(['unitId'])
          || request.resource.data.unitId == resource.data.unitId
        )
        && (
          !resource.data.keys().hasAny(['category'])
          || request.resource.data.category == resource.data.category
        )
        && (
          !resource.data.keys().hasAny(['examRound'])
          || request.resource.data.examRound == resource.data.examRound
        )
        && isValidQuizSubmissionPayload();
    }

    function isValidHistoryClassroomResultCreate() {
      return canUseWestory()
        && request.resource.data.keys().hasOnly([
          'assignmentId',
          'assignmentTitle',
          'uid',
          'studentName',
          'studentGrade',
          'studentClass',
          'studentNumber',
          'answers',
          'score',
          'total',
          'percent',
          'passThresholdPercent',
          'passed',
          'status',
          'answerChecks',
          'cancellationReason',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentTitle is string
        && request.resource.data.studentName is string
        && request.resource.data.studentGrade is string
        && request.resource.data.studentClass is string
        && request.resource.data.studentNumber is string
        && request.resource.data.answers is map
        && request.resource.data.answers.keys().size() <= 200
        && request.resource.data.score is number
        && request.resource.data.total is number
        && request.resource.data.percent is number
        && request.resource.data.passThresholdPercent is number
        && request.resource.data.passed is bool
        && request.resource.data.status is string
        && request.resource.data.answerChecks is list
        && request.resource.data.answerChecks.size() <= 200
        && request.resource.data.cancellationReason is string;
    }

    function isValidRootThinkCloudResponseCreate(sessionId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'textRaw',
          'textNormalized',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.textRaw is string
        && request.resource.data.textRaw.size() <= 120
        && request.resource.data.textNormalized is string
        && request.resource.data.textNormalized.size() <= 120
        && canAccessThinkCloudTarget(
          get(/databases/$(database)/documents/think_cloud_sessions/$(sessionId)).data.targetGrade,
          get(/databases/$(database)/documents/think_cloud_sessions/$(sessionId)).data.targetClass
        )
        && get(/databases/$(database)/documents/think_cloud_sessions/$(sessionId)).data.status == 'active';
    }

    function isValidSemesterThinkCloudResponseCreate(year, semester, sessionId) {
      return isSignedIn()
        && request.resource.data.keys().hasOnly([
          'uid',
          'displayName',
          'textRaw',
          'textNormalized',
          'createdAt'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 20
        && request.resource.data.textRaw is string
        && request.resource.data.textRaw.size() <= 120
        && request.resource.data.textNormalized is string
        && request.resource.data.textNormalized.size() <= 120
        && canAccessThinkCloudTarget(
          get(/databases/$(database)/documents/years/$(year)/semesters/$(semester)/think_cloud_sessions/$(sessionId)).data.targetGrade,
          get(/databases/$(database)/documents/years/$(year)/semesters/$(semester)/think_cloud_sessions/$(sessionId)).data.targetClass
        )
        && get(/databases/$(database)/documents/years/$(year)/semesters/$(semester)/think_cloud_sessions/$(sessionId)).data.status == 'active';
    }

    match /lesson_asset_uploads/{uploadId} {
      allow read: if canUseWestory() && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }

    // 사용자 기본 문서 권한
    match /application_sessions/{userId}/sessions/{authTime} {
      allow read, create, update, delete: if false;
    }

    match /application_session_transitions/{userId} {
      allow read, create, update, delete: if false;
    }

    match /users/{userId} {
      allow get: if canGetUserDocument(userId);
      allow list: if canListUserDocuments();
      allow create: if isRecentlyAuthenticatedAdmin() || isValidOwnStudentCreate(userId);
      allow update: if isRecentlyAuthenticatedAdmin() || isValidOwnStudentUpdate(userId);
      allow delete: if isRecentlyAuthenticatedAdmin();

      match /academic_records/{recordId} {
        allow read: if canUseWestory() && (isOwnUser(userId) || isAdmin());
        allow create, update: if canUseWestory()
          && isOwnUser(userId)
          && request.resource.data.keys().hasOnly(['scores', 'updatedAt'])
          && request.resource.data.scores is map
          && request.resource.data.scores.keys().size() <= 500;
        allow delete: if canUseWestory() && (isOwnUser(userId) || isAdmin());
      }

      match /performance_score_consents/{consentId} {
        allow read: if canUseWestory() && (isOwnUser(userId) || canManagePerformanceScores());
        allow create, update, delete: if false;
      }

      match /performance_scores/{scoreId} {
        allow read: if canUseWestory() && (
          request.auth.token.email == "westoria28@gmail.com" || currentUserIsTeacherProfile()
          || (request.auth.uid == userId && isCurrentSemesterScope(resource.data.academicYear, resource.data.semester)));
        allow create, update, delete: if false;

        match /confirmations/{confirmationId} {
          allow read: if canUseWestory() && (
            request.auth.token.email == "westoria28@gmail.com" || currentUserIsTeacherProfile()
            || (request.auth.uid == userId && isCurrentSemesterScope(
              get(performanceScorePath(userId, scoreId)).data.academicYear,
              get(performanceScorePath(userId, scoreId)).data.semester)));
          allow create, update, delete: if false;
        }
      }

      match /attendance/{recordId} {
        allow read: if isOwnUser(userId) || isAdmin();
        allow create, update, delete: if false;
      }

      match /history_dictionary_words/{wordId} {
        allow read, create, update, delete: if false;
      }
    }

    match /{path=**}/history_dictionary_words/{wordId} {
      allow read, create, update, delete: if false;
    }

    match /site_settings/{docId} {
      allow get: if docId in ['terms', 'privacy', 'school_config', 'interface_config']
        || (docId == 'student_maintenance' && hasWestoryIdentity())
        || (docId in ['config', 'menu_config', 'consent'] && canBootstrapWestory())
        || canUseWestory();
      allow list: if canUseWestory();
      allow create, update, delete: if !(docId in [
          'terms',
          'consent',
          'config',
          'semester_active',
          'student_maintenance',
          'notification_config'
        ])
        && isRecentlyAuthenticatedAdmin();

      match /audit/{auditId} {
        allow read: if docId == 'student_maintenance' && isAdmin();
        allow create, update, delete: if false;
      }

      match /items/{itemId} {
        allow read: if canUseWestory() || (docId == 'consent' && canBootstrapWestory());
        allow create: if docId != 'consent'
          && isRecentlyAuthenticatedAdmin();
        allow delete: if docId != 'consent'
          && isRecentlyAuthenticatedAdmin();
        allow update: if (
            docId != 'consent'
            && isRecentlyAuthenticatedAdmin()
          )
          || (
            docId == 'developer_logs'
            && (
              isDeveloperLogViewUpdate()
              || isSettingsDeveloperLogLikeCountUpdate(itemId)
            )
          );

        match /likes/{likeId} {
          allow read: if canUseWestory();
          allow create: if docId == 'developer_logs'
            && canUseWestory()
            && isStudentRole()
            && likeId == request.auth.uid
            && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
            && request.resource.data.uid == request.auth.uid;
          allow delete: if docId == 'developer_logs'
            && canUseWestory()
            && isStudentRole()
            && likeId == request.auth.uid;
          allow update: if false;
        }
      }
    }

    match /developer_logs/{logId} {
      allow read: if canUseWestory();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || isDeveloperLogViewUpdate()
        || isDeveloperLogLikeCountUpdate(logId);

      match /likes/{likeId} {
        allow read: if canUseWestory();
        allow create: if canUseWestory()
          && isStudentRole()
          && likeId == request.auth.uid
          && request.resource.data.keys().hasOnly(['uid', 'createdAt'])
          && request.resource.data.uid == request.auth.uid;
        allow delete: if canUseWestory()
          && isStudentRole()
          && likeId == request.auth.uid;
        allow update: if false;
      }
    }

    match /teacherPatchNotes/{teacherId}/notes/{noteId} {
      allow get: if isTeacherPatchNoteOwner(teacherId);
      allow list: if isTeacherPatchNoteOwner(teacherId)
        && isTeacherPatchNoteListQuery();
      // All mutations require the owner-scoped Gateway revision/receipt fence.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /command_receipts/{receiptId} {
      allow read, create, update, delete: if false;
    }

    match /command_audit_events/{eventId} {
      allow read, create, update, delete: if false;
    }

    // W7 canonical Wis Economy is callable-only. Ledger rows are immutable and
    // every projection/order mutation is committed through the command gateway.
    match /semester_wis_economies/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_wis_accounts/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_wis_ledger/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_wis_balances/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_wis_rankings/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /wis_product_catalog/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_wis_inventory/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_wis_orders/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_wis_reconciliation_reports/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /wis_legacy_issues/{documentId} {
      allow read, create, update, delete: if false;
    }

    match /semester_learning_contents/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_learning_progress/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_learning_exemptions/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_learning_exemption_requests/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_schedule_events/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_attendance_sessions/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_attendance_records/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_attendance_revisions/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_notices/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_notice_deliveries/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /semester_notice_acknowledgements/{documentId} {
      allow read, create, update, delete: if false;
    }
    match /w8_legacy_issues/{documentId} {
      allow read, create, update, delete: if false;
    }

    // W9 Teacher Operations are callable-only. Owner checks, application-session
    // authority, CAS, TTL, receipts, and audit cannot be expressed safely here.
    match /teacher_drafts/{draftId} {
      allow read, create, update, delete: if false;
    }
    match /teacher_bulk_jobs/{jobId} {
      allow read, create, update, delete: if false;
    }

    // W11 Cutover control-plane documents are callable-only. They reconcile
    // allowlisted Domain command receipts and never accept client SDK writes.
    match /semester_cutover_plans/{planId} {
      allow read, create, update, delete: if false;
    }
    match /semester_cutover_attempts/{attemptId} {
      allow read, create, update, delete: if false;

      match /items/{itemId} {
        allow read, create, update, delete: if false;
      }
    }
    match /semester_cutover_evidence/{evidenceId} {
      allow read, create, update, delete: if false;
    }
    match /semester_cutover_targets/{semesterId} {
      allow read, create, update, delete: if false;
    }

    match /semester_manifests/{semesterId} {
      allow read: if canUseWestory();
      allow create, update, delete: if false;
    }

    match /semester_readiness_reports/{semesterId} {
      allow read: if canUseWestory();
      allow create, update, delete: if false;

      match /versions/{reportId} {
        allow read: if canUseWestory();
        allow create, update, delete: if false;
      }
    }

    match /student_identities/{studentUid} {
      allow get: if canUseWestory()
        && (studentUid == request.auth.uid || canManageStudentEnrollmentData());
      allow list: if canManageStudentEnrollmentData();
      allow create, update, delete: if false;
    }

    match /semester_classes/{classId} {
      allow read: if isAdmin()
        || (
          canUseWestory()
          && !isArchivedSemester(resource.data.semesterId)
          && canManageStudentEnrollmentData()
        );
      allow create, update, delete: if false;
    }

    match /semester_enrollments/{enrollmentId} {
      allow read: if canReadSemesterEnrollmentResource(resource.data);
      allow create, update, delete: if false;
    }

    match /semester_enrollment_slots/{slotId} {
      allow read: if canReadSemesterEnrollmentResource(resource.data);
      allow create, update, delete: if false;
    }

    match /enrollment_roster_imports/{rosterId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /semester_archive_manifests/{semesterId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    match /metadata/{docId} {
      allow read: if canUseWestory();
      allow write: if isAdmin();
    }

    match /curriculum/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /lessons/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /map_resources/{docId} {
      allow read: if canUseWestory();
      allow create, update, delete: if false;
    }

    match /source_archive/{docId} {
      allow read: if canReadSourceArchive();
      allow create, update, delete: if false;
    }

    match /history_dictionary_terms/{termId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /history_dictionary_requests/{requestId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /quiz_questions/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /history_classrooms/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /history_classroom_results/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /history_classroom_exemptions/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /history_classroom_exemption_requests/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /assessment_config/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /grading_plans/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /exam_config/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /performance_score_rosters/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /quiz_results/{resultId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /quiz_submissions/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /semester_assessment_definitions/{docId} {
      allow read, create, update, delete: if false;
    }

    match /semester_assessment_attempts/{docId} {
      allow read, create, update, delete: if false;
    }

    match /semester_assessment_submissions/{docId} {
      allow read, create, update, delete: if false;
    }

    match /semester_assessment_results/{docId} {
      allow read, create, update, delete: if false;
    }

    match /assessment_legacy_issues/{docId} {
      allow read, create, update, delete: if false;
    }

    match /semester_grade_records/{docId} {
      allow read, create, update, delete: if false;
    }

    match /semester_grade_versions/{docId} {
      allow read, create, update, delete: if false;
    }

    match /semester_grade_requests/{docId} {
      allow read, create, update, delete: if false;
    }

    match /semester_grade_attestations/{docId} {
      allow read, create, update, delete: if false;
    }

    match /grade_legacy_issues/{docId} {
      allow read, create, update, delete: if false;
    }

    match /think_cloud_state/{docId} {
      allow read: if false;
      allow create, update, delete: if false;
    }

    match /lesson_progress/{userId} {
      allow read: if false;
      allow create, update, delete: if false;

      match /units/{unitId} {
        allow read: if false;
        allow create, update, delete: if false;
      }
    }

    match /think_cloud_sessions/{sessionId} {
      allow read: if false;
      allow create, update, delete: if false;

      match /responses/{responseId} {
        allow read: if false;
        allow create, update, delete: if false;
      }
    }

    // 학년도/학기 범위 컬렉션 권한
    match /years/{year}/semesters/{semester} {
      match /point_public/{docId} {
        allow read: if canUseWestory() && docId == 'hall_of_fame';
        allow create, update, delete: if false;
      }

      match /point_wallets/{userId} {
        allow read: if canReadOwnPointResource(userId) || canReadPointData();
        allow create, update, delete: if false;
      }

      match /point_transactions/{txId} {
        allow read: if canReadOwnPointResource(resource.data.uid) || canReadPointData();
        allow create, update, delete: if false;
      }

      match /point_products/{productId} {
        allow read: if canUseWestory();
        allow create, update, delete: if false;
      }

      match /point_orders/{orderId} {
        allow read: if canReadOwnPointResource(resource.data.uid) || canReadPointData();
        allow create, update, delete: if false;
      }

      match /point_policies/{policyId} {
        allow read: if canUseWestory();
        allow create, update, delete: if false;
      }

      match /notification_inboxes/{userId} {
        allow read: if canReadOwnPointResource(userId);
        allow create, update, delete: if false;

        match /items/{notificationId} {
          allow read: if canReadOwnPointResource(userId);
          allow create, update, delete: if false;
        }
      }

      match /broadcast_notifications/{notificationId} {
        allow read: if canUseWestory();
        allow create, update, delete: if false;
      }

      match /calendar/{docId} {
        allow read: if canUseWestory();
        allow create, update, delete: if false;
      }

      match /calendar_meta/{docId} {
        allow read: if docId == 'current'
          && (isTrustedW10PVisualFixtureAdmin() || isAdmin());
        allow create, update, delete: if false;
      }

      match /notices/{docId} {
        allow read: if canUseWestory();
        allow create, update, delete: if false;
      }

      match /notices_meta/{docId} {
        allow read: if docId == 'current'
          && (isTrustedW10PVisualFixtureAdmin() || isAdmin());
        allow create, update, delete: if false;
      }

      match /curriculum/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canUseWestory());
        allow write: if false;
      }

      match /lessons/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canUseWestory());
        allow create, update, delete: if false;
      }

      match /map_resources/{docId} {
        allow read: if canUseWestory();
        allow create, update, delete: if false;
      }

      match /history_dictionary_terms/{termId} {
        allow read: if isCurrentSemesterScope(year, semester) && canUseWestory();
        allow create, update, delete: if false;
      }

      match /history_dictionary_requests/{requestId} {
        allow read: if isCurrentSemesterScope(year, semester)
          && canReadHistoryDictionaryRequest(resource.data);
        allow create, update, delete: if false;
      }

      match /dictionary_students/{userId}/history_dictionary_words/{wordId} {
        allow read: if isCurrentSemesterScope(year, semester)
          && canReadOwnedAcademicResource(userId, 'lesson_read');
        allow create, update, delete: if false;
      }

      match /quiz_questions/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canUseWestory());
        allow create, update, delete: if false;
      }

      match /history_classrooms/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (isTrustedW10PVisualFixtureAdmin()
          || canReadHistoryClassroomResource(resource.data));
        allow create, update, delete: if false;
      }

      match /history_classroom_results/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canReadHistoryClassroomResult(resource.data));
        allow create, update, delete: if false;
      }

      match /history_classroom_exemptions/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canReadHistoryClassroomExemption(resource.data));
        allow create, update, delete: if false;
      }

      match /history_classroom_exemption_requests/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canReadHistoryClassroomExemption(resource.data));
        allow create, update, delete: if false;
      }

      match /assessment_config/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canUseWestory());
        allow write: if isCurrentSemesterScope(year, semester) && docId != 'settings'
          && docId != 'performance_score'
          && (isAdmin() || isTeacherRole());
      }

      match /grading_plans/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canUseWestory());
        allow write: if false;
      }

      match /grading_plans_meta/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (docId == 'current'
          && (isTrustedW10PVisualFixtureAdmin() || isAdmin()));
        allow create, update, delete: if false;
      }

      match /exam_config/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (isTrustedW10PVisualFixtureAdmin()
          || canManagePerformanceScores());
        allow write: if false;
      }

      match /performance_score_rosters/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canManagePerformanceScores());
        allow create, update, delete: if false;
      }

      match /performance_score_objections/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canReadPerformanceScoreObjection(resource.data));
        allow create, update, delete: if false;
      }

      match /performance_score_answer_sheet_requests/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canReadPerformanceScoreAnswerSheetRequest(resource.data));
        allow create, update, delete: if false;
      }

      match /quiz_results/{resultId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canReadQuizResult(resource.data));
        allow create, update, delete: if false;
      }

      match /quiz_submissions/{docId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canReadQuizSubmission(resource.data));
        allow create, update, delete: if false;
      }

      match /think_cloud_state/{docId} {
        allow read: if false;
        allow create, update, delete: if false;
      }

      match /lesson_progress/{userId} {
        allow read: if isCurrentSemesterScope(year, semester) && (canUseWestory() && (request.auth.uid == userId || isAdmin()));
        allow create, update, delete: if false;

        match /units/{unitId} {
          allow read: if isCurrentSemesterScope(year, semester) && (canUseWestory() && (request.auth.uid == userId || isAdmin()));
          allow create, update, delete: if false;
        }
      }

      match /lesson_presentations/{unitId}/teachers/{userId} {
        allow read: if isCurrentSemesterScope(year, semester) && (isAdmin() || (canUseWestory() && request.auth.uid == userId && hasPermission('lesson_read')));
        allow write: if false;

        match /classes/{classId} {
          allow read: if isCurrentSemesterScope(year, semester) && (isAdmin() || (canUseWestory() && request.auth.uid == userId && hasPermission('lesson_read')));
          allow write: if false;
        }
      }

      match /think_cloud_sessions/{sessionId} {
        allow read: if false;
        allow create, update, delete: if false;

        match /responses/{responseId} {
          allow read: if false;
          allow create, update, delete: if false;
        }
      }
    }
  }
}
