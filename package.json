{
  "name": "westory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "security:check-supply-chain": "node scripts/check-supply-chain-iocs.mjs",
    "verify:access-gate": "node scripts/verify-access-gate.mjs",
    "verify:assessment-attempt-safety": "node scripts/verify-assessment-attempt-safety.mjs",
    "verify:session-policy": "node scripts/verify-session-policy.mjs",
    "verify:step-up-reauth": "node scripts/verify-step-up-reauth.mjs",
    "verify:session-authority-rules": "firebase emulators:exec --project demo-westory-session-authority --only firestore \"node scripts/verify-session-authority-rules.mjs\"",
    "verify:session-authority-functions": "firebase emulators:exec --project demo-westory-session-authority --only firestore \"npm --prefix functions run verify:session-authority\"",
    "verify:session-authority-storage": "firebase emulators:exec --project demo-westory-session-storage --only auth,firestore,storage \"node scripts/verify-session-authority-storage.mjs\"",
    "verify:session-authority-integration": "firebase emulators:exec --project demo-westory-session-integration --only auth,firestore,functions \"node scripts/verify-session-authority-integration.mjs\"",
    "verify:session-authority-w1r2": "firebase emulators:exec --project demo-westory-session-w1r2 --only auth,firestore,functions,storage \"node scripts/verify-session-authority-rules.mjs && npm --prefix functions run verify:session-authority && node scripts/verify-session-authority-storage.mjs && node scripts/verify-session-authority-integration.mjs\"",
    "verify:firebase-environment": "node scripts/verify-firebase-environment-isolation.mjs",
    "verify:vercel-config": "node scripts/verify-vercel-config.mjs",
    "verify:typescript-baseline": "node scripts/verify-typescript-baseline.mjs",
    "verify:teacher-nav": "node scripts/verify-teacher-nav.mjs",
    "verify:score-warning-rules": "node scripts/verify-score-warning-rules.mjs",
    "verify:teacher-patch-notes-rules": "node scripts/verify-teacher-patch-notes-rules.mjs",
    "verify:w2a-command-gateway-unit": "npm --prefix functions run verify:command-gateway",
    "verify:w2a-command-gateway-rules": "firebase emulators:exec --project demo-westory-session-w2a --only firestore \"node scripts/verify-w2a-command-gateway-rules.mjs\"",
    "verify:w2a-command-gateway-integration": "firebase emulators:exec --project demo-westory-session-w2a --only auth,firestore,functions \"node scripts/verify-w2a-command-gateway-integration.mjs\"",
    "verify:w2a-query-purity": "node scripts/verify-w2a-query-purity.mjs",
    "verify:w2a-command-gateway": "npm run verify:w2a-command-gateway-unit && npm run verify:w2a-query-purity && firebase emulators:exec --project demo-westory-session-w2a --only auth,firestore,functions \"node scripts/verify-w2a-command-gateway-rules.mjs && node scripts/verify-w2a-command-gateway-integration.mjs\"",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.9.0",
    "korean-lunar-calendar": "^0.3.6",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^6.22.0",
    "read-excel-file": "^9.0.9",
    "write-excel-file": "^4.0.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "prettier": "^3.8.1",
    "typescript": "^5.2.2",
    "vite": "^6.2.0"
  }
}
