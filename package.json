{
  "name": "westory",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run typecheck && node scripts/verify-semester-archive.mjs && node scripts/verify-neis-performance-import.mjs && node scripts/verify-grading-performance-import.mjs",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "verify:semester-archive": "node scripts/verify-semester-archive.mjs",
    "verify:login-functions": "npm --prefix functions run check",
    "test:login-session": "firebase emulators:exec --only firestore --config firebase.login-test.json --project demo-westory-session-authority \"node functions/scripts/verify-session-authority.cjs\"",
    "test:student-access": "firebase emulators:exec --only firestore,auth --config firebase.student-access-test.json --project demo-westory-session-student-access \"node scripts/verify-student-access.mjs\"",
    "preview": "vite preview",
    "security:check-supply-chain": "node scripts/check-supply-chain-iocs.mjs",
    "verify:assessment-attempt-safety": "node scripts/verify-assessment-attempt-safety.mjs",
    "verify:assessment-release": "node scripts/verify-assessment-release.mjs",
    "verify:think-cloud-lifecycle": "node scripts/verify-think-cloud-lifecycle.mjs",
    "verify:teacher-nav": "node scripts/verify-teacher-nav.mjs",
    "verify:score-warning-rules": "node scripts/verify-score-warning-rules.mjs",
    "verify:teacher-patch-notes-rules": "node scripts/verify-teacher-patch-notes-rules.mjs",
    "verify:teacher-readiness-rules": "node scripts/verify-teacher-readiness-rules.mjs",
    "verify:semester-readiness-client": "node scripts/verify-semester-readiness-client.mjs",
    "verify:teacher-patch-note-commands": "node scripts/verify-teacher-patch-note-commands.mjs && node scripts/verify-teacher-patch-note-sync.mjs && node scripts/verify-teacher-patch-memo-controller.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\""
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "chart.js": "^4.5.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.9.0",
    "jszip": "^3.10.2",
    "korean-lunar-calendar": "^0.3.6",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^6.22.0",
    "read-excel-file": "^9.0.9",
    "write-excel-file": "^4.0.5"
  },
  "overrides": {
    "brace-expansion": "^5.0.6",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.14.0",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "prettier": "^3.8.1",
    "typescript": "^5.2.2",
    "vite": "^6.2.0"
  }
}
